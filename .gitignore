# Base ignores. Applies to every project regardless of ecosystem.
# Combine with the ecosystem file from dotfiles/<ecosystem>/gitignore and with
# dotfiles/os-editor/gitignore.
#
# ⛔ .gitignore only applies to files git is not ALREADY tracking. Adding a line
# does not untrack what is already in. Check with: git ls-files

# ── secrets. Never committed, no exceptions ─────────────────────────────────
# ⛔ Listed BEFORE the files exist, so one can never be staged by accident.
# A credential file added here after the fact was trackable in between.
.env
.env.*
!.env.example
.dev.vars
.dev.vars.*
!.dev.vars.example
*.pem
*.key
*.p12
*.pfx
*.keystore
id_rsa
id_ed25519
credentials.json
service-account*.json
*.token
.*_token
.*-token

# ── scratch and temporary work ─────────────────────────────────────────────
.tmp/
tmp/
scratch/
.scratch/

# ── logs ────────────────────────────────────────────────────────────────────
*.log
logs/

# ── local databases ─────────────────────────────────────────────────────────
*.sqlite
*.sqlite3
*.sqlite-journal
*.sqlite-wal
*.db-shm
*.db-wal

# ── coverage and test output ───────────────────────────────────────────────
coverage/
.coverage
htmlcov/
test-results/
.nyc_output/

# ── agent and assistant local files ────────────────────────────────────────
.claude/settings.local.json
CLAUDE.local.md
.aider*
.cursorignore

# ── reference material cloned for study ────────────────────────────────────
# The trees are re-clonable from the URL every write-up records. The DERIVED
# write-up is tracked; the clone is not. See docs/methodology/references.md.
reference/
references/
reference_attachments/
temp/

# ⛔ WINDOWS RESERVED DEVICE NAMES. Two different things create one as a real
# file, and only the first is something you wrote:
#   1. your own redirect: 2>/dev/null under a shell that does not map it makes
#      a real file called nul, which git then tracks, which breaks git stash
#      outright, and which cannot be deleted by rm or by Python;
#   2. a tool's own argument list: podman machine ssh passes
#      -o UserKnownHostsFile=NUL to its ssh, and under Git Bash that is a
#      filename, so a 99-byte NUL holding an ssh host key lands in whatever
#      directory the command ran in. Usually a repository.
# ⚠ MSYS_NO_PATHCONV does not prevent the second one: the argument never looked
# like a path. Ignoring the whole set is what stops the recurrence.
nul
CON
PRN
AUX
NUL
COM[1-9]
LPT[1-9]
CON.*
PRN.*
AUX.*
NUL.*
COM[1-9].*
LPT[1-9].*

# Shell script projects. Combine with dotfiles/common/gitignore and
# dotfiles/os-editor/gitignore.

# shellcheck and shfmt leave nothing behind, so this file is mostly about the
# things a shell project accumulates around itself.

*.bak
*.orig
*.rej
.shellcheckrc.local

# A script that writes a report writes it here. The RUNNERS are tracked source;
# the CAPTURES are not. A run that IS the evidence for an item goes in
# deliberately with: git add -f
out/
reports/

# Operating system and editor noise. Combine with the base and the ecosystem
# file. None of this is ever anyone else's business.

# macOS
.DS_Store
.DS_Store?
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
Desktop.ini
desktop.ini
$RECYCLE.BIN/
*.lnk

# Linux
.directory
.Trash-*
.nfs*

# Editors
.vscode/
!.vscode/extensions.json
!.vscode/settings.shared.json
.idea/
*.iml
*.swp
*.swo
*~
.vim/
.nvimlog
*.sublime-workspace
.history/
.fleet/
\#*\#
.\#*
